    "//": "PDN. Default LibreLane met4/met5 vias onto wrap met4 PG pins (SRAM model).",
    "FP_PDN_HORIZONTAL_HALO": 10,
    "FP_PDN_VERTICAL_HALO": 10,
    "FP_PDN_VOFFSET": 5,
    "FP_PDN_HOFFSET": 5,
    "FP_PDN_VWIDTH": 3.1,
    "FP_PDN_HWIDTH": 3.1,
    "FP_PDN_VSPACING": 15.5,
    "FP_PDN_HSPACING": 15.5,
    "FP_PDN_VPITCH": 180,
    "FP_PDN_HPITCH": 180,
    "ERROR_ON_PDN_VIOLATIONS": false,

    "//": "SRAM-style parent stream-out: Magic black-boxes wrap GDS (GDS_FILE + FIXED_BBOX). Skip Magic DRC on analog OBS datatypes. MAGIC_CAPTURE_ERRORS false so OBS 67/10 68/10 69/10 do not fail get_bbox. XOR vs KLayout is expected if Magic keeps DEF TAPER that KLayout drops — do not fail the flow on that.",
    "RUN_MAGIC_DRC": false,
    "MAGIC_DRC_USE_GDS": false,
    "ERROR_ON_MAGIC_DRC": false,
    "RUN_MAGIC_STREAMOUT": true,
    "RUN_MAGIC_WRITE_LEF": true,
    "MAGIC_CAPTURE_ERRORS": false,
    "PRIMARY_GDSII_STREAMOUT_TOOL": "magic",
    "MAGIC_MACRO_STD_CELL_SOURCE": "macro",
    "ERROR_ON_XOR_ERROR": false,
    "MAGIC_EXT_USE_GDS": false,
    "MAGIC_EXT_ABSTRACT_CELLS": [
        "^CF_BUF_HIZ_core$",
        "^CF_ADC_DSM20_core$",
        "^CF_BGR_core$",
        "^CF_REFBUF_core$",
        "^CF_SRAM_1024x32$"
    ],

    "DRT_THREADS": 1,
    "MAX_TRANSITION_CONSTRAINT": 1.5,

    "//": "met4/met5 sit around 50% derated from the analog obstructions above, so global routing has little slack. At the 0.3 default the router closes but leaves an m1.2 spacing violation; 0.2 signs off clean. Do not set GRT_ALLOW_CONGESTION: it lets DRT finish with shorts, which surfaces as an LVS net-count mismatch rather than a routing error.",
    "GRT_ADJUSTMENT": 0.2,
    "GRT_OVERFLOW_ITERS": 100,

    "//": "The SoC copies of the analog wrap LEFs omit core met3/met4 OBS. The targeted north-band guards reproduce the 1,420-blockage DRC-clean route without sealing the whole DSM core. The IP repos retain the full core OBS.",
    "ROUTING_OBSTRUCTIONS": [
        "met5 1015.00 1490.00 1045.00 1500.00",
        "met5 640.00 1506.00 1420.00 1510.20",
        "met4 656.00 1496.60 1365.70 1536.40",
        "met5 656.00 1496.60 1368.00 1536.40",
        "met5 1368.00 1520.20 1620.00 1532.00",
        "met3 1546.50 1483.20 1558.70 1521.80",
        "met3 1519.00 1496.15 1603.30 1497.50"
    ],

    "//": "Fixed configurations for caravel. You should NOT edit this section",
    "DESIGN_NAME": "user_project_wrapper",
    "FP_SIZING": "absolute",
    "DIE_AREA": [0, 0, 2920, 3520],
    "FP_DEF_TEMPLATE": "dir::fixed_dont_change/user_project_wrapper.def",
    "VDD_NETS": [
