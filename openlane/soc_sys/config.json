        "dir::../../ip/CF_UART/hdl/rtl/CF_UART.v",
        "dir::../../ip/CF_UART/hdl/rtl/bus_wrappers/CF_UART_WB.v",
        "dir::../../ip/CF_SPI/hdl/rtl/spi_master.v",
        "dir::../../ip/CF_SPI/hdl/rtl/CF_SPI.v",
        "dir::../../ip/CF_SPI/hdl/rtl/bus_wrappers/CF_SPI_WB.v",
        "dir::../../ip/CF_I2C/hdl/rtl/axis_fifo.v",
        "dir::../../ip/CF_I2C/hdl/rtl/i2c_master.v",
        "dir::../../ip/CF_I2C/hdl/rtl/i2c_master_wbs_16.v",
        "dir::../../ip/CF_I2C/hdl/rtl/bus_wrappers/CF_I2C_WB.v",
        "dir::../../ip/CF_TMR32/hdl/rtl/CF_TMR32.v",
        "dir::../../ip/CF_TMR32/hdl/rtl/bus_wrappers/CF_TMR32_WB.v"
    ],
    "VERILOG_POWER_DEFINE": "USE_POWER_PINS",
    "CLOCK_PERIOD": 25,
    "CLOCK_PORT": "wb_clk_i",
    "FP_SIZING": "absolute",
    "DIE_AREA": [0, 0, 1200, 500],
    "FP_PIN_ORDER_CFG": "dir::pin_order.cfg",
    "PNR_SDC_FILE": "dir::base.sdc",
    "SIGNOFF_SDC_FILE": "dir::base.sdc",
    "VDD_NETS": ["vccd1"],
    "GND_NETS": ["vssd1"],
    "FP_PDN_MULTILAYER": false,

    "//": "Stay off met4/met5 so the wrapper keeps a clean routing channel over this 1200x500 footprint. At met5 the macro left ~15 met4 OBS rects and the wrapper's global routing hit GRT-0118.",
    "RT_MAX_LAYER": "met3",

    "MAX_TRANSITION_CONSTRAINT": 1.0,
    "MAX_FANOUT_CONSTRAINT": 16,

    "//": "Wishbone input hold failed by 0.13 ns at the wrapper with the 0.1 ns default. Setup had about 7.7 ns of slack.",
    "PL_RESIZER_HOLD_SLACK_MARGIN": 0.4,
    "PL_RESIZER_SETUP_SLACK_MARGIN": 0.2,
    "MAGIC_DEF_LABELS": false,
    "RUN_IRDROP_REPORT": false,
    "ERROR_ON_SYNTH_CHECKS": false,
    "ERROR_ON_LINTER_ERRORS": false,
    "meta": {
        "version": 2
    }
}
